<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc :text="$site.host_url"></loc>
    <lastmod :text="$page.date.format('2006-01-02')"></lastmod>
  </url>
  <ctx :loop="$page.subpages()">
    <ctx :if="$loop.it.link().endsWith('/404/').not()">
      <url>
        <loc :text="$site.host_url.addPath($loop.it.link())"></loc>
        <lastmod :text="$loop.it.date.format('2006-01-02')"></lastmod>
      </url>
    </ctx>
  </ctx>
  <ctx :loop="$site.page('woods').subpages()">
    <url>
      <loc :text="$site.host_url.addPath($loop.it.link())"></loc>
      <lastmod :text="$loop.it.date.format('2006-01-02')"></lastmod>
    </url>
  </ctx>
</urlset>
